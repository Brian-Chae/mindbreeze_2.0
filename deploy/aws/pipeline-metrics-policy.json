{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PutPipelineBacklogMetrics",
      "Effect": "Allow",
      "Action": ["cloudwatch:PutMetricData"],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "cloudwatch:namespace": "MindBreeze/Pipeline" }
      }
    }
  ]
}
