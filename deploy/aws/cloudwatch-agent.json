{
  "agent": { "metrics_collection_interval": 60, "run_as_user": "cwagent" },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem":  { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"], "drop_device": true }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/nginx/error.log",  "log_group_name": "/mindbreeze/prod/nginx",  "log_stream_name": "{instance_id}-error" },
          { "file_path": "/var/log/syslog",           "log_group_name": "/mindbreeze/prod/system", "log_stream_name": "{instance_id}-syslog" }
        ]
      }
    }
  }
}
