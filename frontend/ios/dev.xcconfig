APP_DISPLAY_NAME = MB Dev
ASSETCATALOG_COMPILER_APPICON_NAME = AppIconDev
// dev 번들용 Google iOS OAuth 클라이언트의 REVERSED_CLIENT_ID. 아래 local 파일이 있으면 덮어쓴다(값 커밋 금지).
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1087454235919-r2r01n0q2o4s1qmjcoirghvjc24jknn2
#include? "dev.local.xcconfig"
