# MIND BREEZE 2.0 — 백엔드 환경변수 예시 (값은 예시, 비밀값 넣지 말 것)
ENVIRONMENT=development
DATABASE_URL=postgresql://localhost:5432/mindbreeze_dev
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=
# SDD-220: AI 기능 서버 차단(기본 false). 운영 출시 시 false + GEMINI/OPENAI 키 비움.
AI_FEATURES_ENABLED=false
GEMINI_API_KEY=
OPENAI_API_KEY=
# SDD-220: Sign in with Apple
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SOCIAL_TOKEN_ENCRYPTION_KEY=
# SDD-220: 탈퇴 30일 후 영구 삭제 스위프(기본 false, dry-run 검토 후 활성화)
ACCOUNT_DELETION_SWEEP_ENABLED=false
ACCOUNT_DELETION_GRACE_DAYS=30
