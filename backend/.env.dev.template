# ──────────────────────────────────────
# MIND BREEZE 2.0 — Dev Backend 환경변수
# ──────────────────────────────────────

DEBUG=true

# SDD-019 / INFRA-12: dev 배포 프론트는 VITE_ENABLE_ROLE_SIM=true 로 빌드되므로
#   백엔드도 dev 역할 시뮬레이션 라우터(app/api/v1/dev_auth)를 등록하도록 맞춘다.
#   (라우터 include 조건: environment != "production" AND enable_dev_role_simulation)
ENVIRONMENT=development
ENABLE_DEV_ROLE_SIMULATION=true

# Database (Docker 내부 서비스명)
# INFRA-13: app/core/database.py 가 동기 create_engine 이므로 psycopg2 드라이버로 통일(asyncpg 제거).
DATABASE_URL=postgresql+psycopg2://mindbreeze:mindbreeze_dev_2026@postgres:5432/mindbreeze_dev
DATABASE_URL_SYNC=postgresql://mindbreeze:mindbreeze_dev_2026@postgres:5432/mindbreeze_dev

# Redis (Docker 내부 서비스명)
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Resend Email
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=MIND BREEZE DEV <onboarding@resend.dev>

# S3 (개발용 MinIO 또는 실제 S3)
S3_BUCKET=mindbreeze-dev
S3_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=dev
