# ──────────────────────────────────────
# MIND BREEZE 2.0 — Prod 환경변수 (릴리즈 시 사용)
# ──────────────────────────────────────

DEBUG=false

# Database (RDS)
# INFRA-13: 백엔드가 동기 create_engine 이므로 psycopg2 드라이버로 통일한다(asyncpg 불일치 해소).
DATABASE_URL=postgresql+psycopg2://mindbreeze:<RDS_PASSWORD>@<RDS_ENDPOINT>:5432/mindbreeze
DATABASE_URL_SYNC=postgresql://mindbreeze:<RDS_PASSWORD>@<RDS_ENDPOINT>:5432/mindbreeze

# Redis (ElastiCache 또는 EC2)
REDIS_URL=redis://<REDIS_ENDPOINT>:6379/0

# JWT
JWT_SECRET_KEY=<생성된_랜덤_키_64자>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Resend Email
RESEND_API_KEY=<RESEND_API_KEY>
RESEND_FROM_EMAIL=MIND BREEZE <noreply@mindbreeze.kr>

# S3
S3_BUCKET=mindbreeze-prod
S3_REGION=ap-northeast-1
