{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.mindbreeze.local/session-live-v2/ack.schema.json",
  "title": "CommandAck (plan §3.1). applied=DB commit+Redis projection, 상대 렌더 의미 아님",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "status",
    "epoch",
    "cursors",
    "committed"
  ],
  "properties": {
    "command_id": {
      "$ref": "common.schema.json#/definitions/Uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "duplicate",
        "rejected",
        "retryable"
      ]
    },
    "epoch": {
      "$ref": "common.schema.json#/definitions/U64"
    },
    "cursors": {
      "$ref": "common.schema.json#/definitions/Cursors"
    },
    "entity_version": {
      "$ref": "common.schema.json#/definitions/U64"
    },
    "code": {
      "$ref": "common.schema.json#/definitions/ReasonCode"
    },
    "retry_after_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000
    },
    "committed": {
      "type": "boolean",
      "description": "true+retryable 이면 재실행 대신 ledger 결과 조회"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "retryable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "retry_after_ms"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "applied"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "committed": {
            "const": true
          }
        }
      }
    }
  ]
}
