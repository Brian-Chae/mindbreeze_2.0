    "EEGOutput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "validity": {
          "default": "valid",
          "enum": [
            "valid",
            "invalid"
          ],
          "title": "Validity",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "saturated",
                "step",
                "leadoff",
                "gap",
                "outlier"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "filteredData": {
          "$ref": "#/$defs/DerivedReference"
        },
        "signalQuality": {
          "$ref": "#/$defs/EEGQuality"
        },
        "bandPowers": {
          "$ref": "#/$defs/BandPowers"
        },
        "brainState": {
          "$ref": "#/$defs/BrainState"
        },
        "frequencySpectrum": {
          "$ref": "#/$defs/Spectrum"
        },
        "indices": {
          "$ref": "#/$defs/EEGIndices"
        },
        "rawAnalysis": {
          "$ref": "#/$defs/EEGRawAnalysis"
        },
        "channelBandPowers": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/BandPowers"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Channelbandpowers"
        },
        "channelBandPowers_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Channelbandpowers Reason"
        }
      },
      "required": [
        "filteredData",
        "signalQuality",
        "bandPowers",
        "brainState",
        "frequencySpectrum",
        "indices",
        "rawAnalysis",
        "channelBandPowers",
        "channelBandPowers_reason"
      ],
      "title": "EEGOutput",
      "type": "object"
    },
