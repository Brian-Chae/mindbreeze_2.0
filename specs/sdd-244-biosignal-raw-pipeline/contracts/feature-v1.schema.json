    "AlgorithmSnapshot": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "algorithm_id": {
          "minLength": 1,
          "title": "Algorithm Id",
          "type": "string"
        },
        "algorithm_version": {
          "minLength": 1,
          "title": "Algorithm Version",
          "type": "string"
        },
        "parameters_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parameters Hash",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "filter_version": {
          "minLength": 1,
          "title": "Filter Version",
          "type": "string"
        },
        "build": {
          "minLength": 1,
          "title": "Build",
          "type": "string"
        }
      },
      "required": [
        "algorithm_id",
        "algorithm_version",
        "parameters_hash",
        "parameters",
        "filter_version",
        "build"
      ],
