    "DerivedReference": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "artifact_id_alias": {
          "pattern": "^[A-Z][A-Za-z0-9_-]{0,63}$",
          "title": "Artifact Id Alias",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "first_sample_index": {
          "minimum": 0,
          "title": "First Sample Index",
          "type": "integer"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "availability": {
          "enum": [
            "available",
            "expired",
            "withdrawn",
            "unknown"
          ],
          "title": "Availability",
          "type": "string"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
