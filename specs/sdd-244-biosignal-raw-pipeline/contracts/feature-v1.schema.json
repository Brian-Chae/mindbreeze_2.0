            {
              "type": "null"
            }
          ],
          "title": "Unavailable Reason"
        }
      },
      "required": [
        "artifact_id_alias",
        "sha256",
        "field_path",
        "first_sample_index",
        "sample_count",
        "availability",
        "unavailable_reason"
      ],
      "title": "DerivedReference",
      "type": "object"
    },
